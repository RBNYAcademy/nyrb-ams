{
  "version": 2,
  "alias": ["rbny-ams.vercel.app"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/api/gps",      "destination": "/api/gps.js" },
    { "source": "/api/cmj",      "destination": "/api/cmj.js" },
    { "source": "/api/nordbord", "destination": "/api/nordbord.js" },
    { "source": "/api/hipforce", "destination": "/api/hipforce.js" },
    { "source": "/api/sprint",   "destination": "/api/sprint.js" },
    { "source": "/api/505",      "destination": "/api/505.js" },
    { "source": "/api/broad",    "destination": "/api/broad.js" },
    { "source": "/api/mas",      "destination": "/api/mas.js" },
    { "source": "/api/movement", "destination": "/api/movement.js" },
    { "source": "/api/trialist", "destination": "/api/trialist.js" },
    { "source": "/api/phv",      "destination": "/api/phv.js" },
    { "source": "/api/rpm",      "destination": "/api/rpm.js" },
    { "source": "/api/medical",  "destination": "/api/phv.js?type=medical" },
    { "source": "/api/playercards", "destination": "/api/phv.js?type=cards" }
  ]
}
